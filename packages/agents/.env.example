# Copy to .env in this directory or at the repo root (search walks upward from the package).

# Default LiteLLM model (optional; agent default_model and body "model" override this)
# DEFAULT_LLM_MODEL=ollama/llama3.2

# Ollama — required for ollama/ models (LiteLLM). Examples:
# OLLAMA_API_BASE=http://ollama:11434   # Dev Container / Compose (service name ollama)
# OLLAMA_API_BASE=http://127.0.0.1:11434   # Ollama on host / published port

# Remote providers (set when using matching model ids)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: merge extra args into LiteLLM client construction
# LLM_LITELLM_CLIENT_ARGS_JSON={"timeout": 120}

# Optional: alternate agent registry file
# AGENTS_REGISTRY_PATH=/path/to/agents.yaml

# Agent HTTP server (run())
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8080
# LOG_LEVEL=INFO
