# Public URL for the BFF (browser calls this). In dev, Vite can proxy /api to the BFF — see vite.config.ts.
# Example: leave unset and use default /api with proxy, or set full URL:
# VITE_API_URL=http://localhost:8000

# If you proxy manually, optional Ollama on host (browser rarely needs this; BFF uses OLLAMA_HOST server-side).
# VITE_OLLAMA_URL=http://localhost:11434
